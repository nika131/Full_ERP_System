    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "if (pm.response.code === 200) {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    \r",
                  "    pm.environment.set(\"jwt_token\", jsonData.token);\r",
                  "    \r",
                  "    console.log(\"Token successfully captured and saved to environment.\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"{{admin_username}}\",\r\n  \"password\": \"{{admin_password}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:5116/api/Auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5116",
              "path": [
                "api",
                "Auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
