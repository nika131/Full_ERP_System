  const hour = Math.floor(i / 2).toString().padStart(2, '0');
  const minute = i % 2 === 0 ? '00' : '30';
  return `${hour}:${minute}`;
});

const defaultEnd = new Date();
const defaultStart = new Date();
defaultStart.setDate(defaultEnd.getDate() - 7);

